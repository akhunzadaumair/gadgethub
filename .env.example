# ====================================================================
# GADGETHUB - Complete Environment Configuration
# ====================================================================
# Never put real secrets in this example file, frontend code, or source control.
# Copy this file to .env and provide your actual credentials.

# --------------------------------------------------------------------
# 1. Store Administrator Access
# --------------------------------------------------------------------
# Password used to authenticate the Merchant Admin Console at /#admin
ADMIN_PASSWORD=your_secure_admin_password

# --------------------------------------------------------------------
# 2. Supabase / PostgreSQL Database Integration
# --------------------------------------------------------------------
# Your Supabase Project URL (e.g. https://hsxvytgcjandgnaenbgw.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Secret Key (Required for server-side order management & RLS bypass)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Supabase Anon / Publishable Key (Fallback if service role key is not yet set)
SUPABASE_KEY=your_supabase_anon_public_key

# PostgreSQL Direct Connection String (Optional, for direct migration scripts)
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# --------------------------------------------------------------------
# 3. Store Owner Order Notifications (Email via Resend)
# --------------------------------------------------------------------
# Resend API Key (Sign up at https://resend.com to generate an API key)
RESEND_API_KEY=re_your_resend_api_key

# Store Owner Email Address that receives order alerts
ORDER_NOTIFICATION_EMAIL=akhunzadaumair27@gmail.com

# Verified sender address or default Resend testing sender
EMAIL_FROM=Gadgethub Orders <onboarding@resend.dev>

# --------------------------------------------------------------------
# 4. Store Owner Order Notifications (WhatsApp Business Cloud API)
# --------------------------------------------------------------------
# Meta System User / WhatsApp Access Token with whatsapp_business_messaging permission
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_access_token

# Meta WhatsApp Cloud API Phone Number ID (from Meta App Dashboard -> WhatsApp -> API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Store Owner WhatsApp Recipient Number in international format (e.g. +923293778337)
WHATSAPP_RECIPIENT_NUMBER=+923293778337

# Optional WhatsApp Approved Message Template name (if blank, sends formatted text message)
WHATSAPP_TEMPLATE_NAME=

# Language code for the WhatsApp message template (e.g. en_US, en, ur)
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# --------------------------------------------------------------------
# 5. AI Studio Runtime (Injected automatically in cloud environment)
# --------------------------------------------------------------------
GEMINI_API_KEY=MY_GEMINI_API_KEY
APP_URL=MY_APP_URL
